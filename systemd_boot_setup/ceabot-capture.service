[Unit]
Description=CEAbot Orbbec Capture Server
After=network-online.target orbbec-camera.service
Wants=network-online.target orbbec-camera.service

[Service]
Type=simple
User=thiwa
WorkingDirectory=/home/thiwa/CEAbot_Rpi
Environment=HOME=/home/thiwa
EnvironmentFile=-/etc/ceabot-capture.env
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec /usr/bin/python3 /home/thiwa/CEAbot_Rpi/rpi_orbbec_capture_server.py --bind 10.20.0.200'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
