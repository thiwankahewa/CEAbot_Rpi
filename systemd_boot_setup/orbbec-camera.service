[Unit]
Description=Orbbec Gemini 330 ROS 2 Camera
After=network.target
Wants=network.target

[Service]
Type=simple
User=thiwa
Environment=HOME=/home/thiwa
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && exec ros2 launch orbbec_camera gemini_330_series.launch.py camera_name:=gemini336 depth_registration:=true align_mode:=SW enable_point_cloud:=false enable_colored_point_cloud:=false'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
